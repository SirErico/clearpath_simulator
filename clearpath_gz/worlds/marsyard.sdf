<?xml version='1.0' encoding='ASCII' ?>
<sdf version='1.4'>
  <world name="marsyard">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- Fortress uses "ignition" naming, not "gz" -->
    <plugin name="ignition::gazebo::systems::Contact"         filename="ignition-gazebo-contact-system"/>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Sensors" filename="ignition-gazebo-sensors-system"/>
    <plugin name="ignition::gazebo::systems::Imu" filename="ignition-gazebo-imu-system"/>

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.8 0.5 0.3 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- Marsyard model -->
    <model name="marsyard2024">
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name="scene_link">

        <!-- Visual -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://marsyard/marsyard2024_processed.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <!-- Collision -->
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://marsyard/marsyard2024_processed.dae</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
                <!-- Removed fdir1 - let it auto-calculate based on contact -->
              </ode>
              <bullet>
                <friction>1.5</friction>
                <friction2>1.5</friction2>
              </bullet>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>100</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>

      </link>
    </model>

  </world>
</sdf>
