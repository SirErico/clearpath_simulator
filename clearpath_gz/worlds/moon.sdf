<?xml version='1.0' encoding='ASCII' ?>
<sdf version='1.4'>
  <world name='moon'>
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
      
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>1</shadows>
      <grid>false</grid>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-22.986687</latitude_deg>
      <longitude_deg>-43.202501</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name='moon'>
      <pose>0 0 0 0 0 0</pose>
      <static>true</static>
      <link name='moon'>
        <collision name='moon_collision'>
          <geometry>
            <mesh>
              <uri>model://moon/moon.stl</uri>
              <scale>10 10 2</scale>
            </mesh>
          </geometry>
        </collision>
        <visual name='moon_visual'>
          <geometry>
            <mesh>
              <uri>model://moon/moon.stl</uri>
              <scale>10 10 2</scale>
            </mesh>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
            <pbr>
              <metal>
                <albedo_map>model://moon/moon_surface.jpg</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>