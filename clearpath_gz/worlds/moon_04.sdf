              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1e6</kp>
                <kd>1e2</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <heightmap>
              <uri>file:///ws/src/clearpath_simulator/clearpath_gz/heightmaps/moon_04_heightmap.png</uri>
              <size>20.00 20.00 1.00</size>
              <pos>0 0 0</pos>
              <sampling>1</sampling>
              <texture>
